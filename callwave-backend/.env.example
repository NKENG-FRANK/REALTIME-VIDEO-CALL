# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── JWT Secrets (change in production!) ────────────────────────────────────
JWT_SECRET=

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=callwave
DB_USER=callwave
DB_PASSWORD=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
# Use a separate random URL-safe secret. Compose uses DB_PASSWORD if unset,
# solely for compatibility with existing deployments.
RABBITMQ_PASSWORD=
RABBITMQ_URL=amqp://callwave:replace-with-rabbitmq-password@localhost:5672

# ─── Mediasoup (video-calls service) ─────────────────────────────────────────
# Set to your machine's LAN/public IP so ICE candidates are reachable by clients
ANNOUNCED_IP=144.91.89.100

# ─── CoTURN Relay (ephemeral HMAC credentials, minimum 32 chars) ─────────────
TURN_SHARED_SECRET=
TURN_URLS=turn:144.91.89.100:3478?transport=udp,turn:144.91.89.100:3478?transport=tcp
