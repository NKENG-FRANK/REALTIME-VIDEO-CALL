# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── JWT Secrets (change in production!) ────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_change_in_prod
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_prod

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=callwave
DB_USER=callwave
DB_PASSWORD=callwave_secret

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://callwave:callwave_secret@localhost:5672

# ─── Mediasoup (video-calls service) ─────────────────────────────────────────
# Set to your machine's LAN/public IP so ICE candidates are reachable by clients
ANNOUNCED_IP=127.0.0.1
